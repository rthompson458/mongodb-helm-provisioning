# terraformController.config
#
# Local controller configuration for Rich's K3D nix-dev cluster.
# Do NOT put the Vault token in this file. Set VAULT_TOKEN in the shell.

[Vault]
address = http://127.0.0.1:8200
token_environment_variable = VAULT_TOKEN
mount = secret
base_path = mongodb

[Terraform]
repository_url = https://github.com/rthompson458/mongodb-helm-provisioning.git
branch = main
subdirectory = terraform-dbaas
cache_directory = ~/.cache/terraformController/mongodb-helm-provisioning
backend_namespace = mongodb
backend_secret_suffix = mongodb-vault-controller

[Kubernetes]
kubeconfig = ~/.kube/config
context = k3d-nix-dev
namespace = mongodb

[MongoDB]
ops_manager_config_map = my-project
ops_manager_credentials_secret = organization-secret
auth_database = admin
default_version = 8.0.29
default_members = 3
persistent = true
storage_class = mongodb-data-local
storage_size = 16Gi

[Sharding]
# AddShardedCluster uses default_shards when --shards is omitted.
# The customer CLI help reads this value from configuration and displays the
# current configured default. --shards N overrides it for one request.
default_shards = 3
default_members_per_shard = 3
default_mongos = 2
default_config_servers = 3

[Storage]
# static-local = current nix-k3d host-backed PV model.
# dynamic      = customer/cluster StorageClass provisions volumes; no docker exec/PV prep.
mode = static-local
base_path = /home/rich/mongodb-dbaas-dev/storage
node_name = k3d-nix-dev-server-0

[Rotation]
days = 30

[Runtime]
# Used for safe database creation/deletion checks from inside the cluster.
mongo_image = mongo:8.0
placeholder_collection = __dbaas_metadata
job_timeout_seconds = 300
replica_set_ready_timeout_seconds = 900
sharded_cluster_ready_timeout_seconds = 1200

[Logging]
# =====================================================================
# LOGGING CONFIGURATION
# =====================================================================
# enabled:
#   true  = write controller operational logs.
#   false = do not create a controller log file.
enabled = true
#
# level:
#   DEBUG, INFO, WARNING, ERROR, or CRITICAL.
level = INFO
#
# directory:
#   May be a RELATIVE or ABSOLUTE path.
#
#   Relative example:
#       directory = logs
#
#   A relative path is resolved from the directory that contains THIS
#   terraformController.config file. Therefore, "logs" normally means:
#       <repository-directory>/logs
#
#   Absolute example:
#       directory = /var/log/terraformController
#
#   The directory is created automatically if it does not already exist.
directory = logs
#
# mode:
#   append    = keep existing file contents and add new log entries at the end.
#   overwrite = start the selected log file fresh each time the controller runs.
#
#   Recommended default: append
mode = append
#
# filename_format:
#   Leave this BLANK to use:
#       Controller.log
#
#   If a value is supplied, standard Python/Unix strftime date/time tokens
#   are expanded when the controller starts.
#
#   Common tokens:
#       %Y = four-digit year       Example: 2026
#       %m = two-digit month       Example: 09
#       %d = two-digit day         Example: 08
#       %H = hour, 24-hour clock   Example: 16
#       %M = minute                Example: 07
#       %S = second                Example: 42
#
#   IMPORTANT:
#       Lowercase %m = MONTH
#       Uppercase %M = MINUTE
#
#   Examples:
#       filename_format = Controller-%Y%m%d-%H%M.log
#       -> Controller-20260908-1607.log
#
#       filename_format = %Y%m%d-%H%M%S-Controller.log
#       -> 20260908-160742-Controller.log
#
#   This setting is a FILE NAME only. Put directory information in "directory".
filename_format =
# =====================================================================
